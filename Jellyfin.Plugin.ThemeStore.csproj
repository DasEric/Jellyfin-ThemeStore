<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <AssemblyName>Jellyfin.Plugin.ThemeStore</AssemblyName>
    <RootNamespace>Jellyfin.Plugin.ThemeStore</RootNamespace>
    <Version>1.1.0.0</Version>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <FileVersion>1.1.0.0</FileVersion>
    <Authors>Jellyfin Theme Store contributors; based on work by Jellyfin Plugin Group</Authors>
    <RepositoryUrl>https://github.com/DasEric/Jellyfin-ThemeStore</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Description>A per-user CSS theme store for Jellyfin Web.</Description>
    <Copyright>Original portions Copyright © 2026 Jellyfin SM; modifications Copyright © 2026 Jellyfin Theme Store contributors</Copyright>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="12.0.0" ExcludeAssets="runtime" />
    <PackageReference Include="Jellyfin.Model" Version="12.0.0" ExcludeAssets="runtime" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" ExcludeAssets="runtime" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Configuration\configPage.html" />
    <EmbeddedResource Include="Configuration\injection.js" />
    <EmbeddedResource Include="Configuration\userThemePage.html" />
    <EmbeddedResource Include="Configuration\userThemePage.js" />
    <Compile Remove="tests\**\*.cs" />
    <None Remove="tests\**\*" />
  </ItemGroup>
</Project>
